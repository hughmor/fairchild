/target/
Cargo.lock
*.osdi
*.so
*.dylib
*.d
.DS_Store
/tmp/
examples/*/*.png
examples/*/*.csv
*.code-workspace

# internal notes: roadmap, design discussions, honest accounting, scratch,
# legacy references. Never committed — public-facing docs live in docs/.
# Holds sotu.md (state-of-the-union) and moved internal docs.
/_notes/
sotu.md

# kicad_photonics is a committed examples dir — only KiCad's per-user cruft
# and its regenerable PCB stay out.
examples/kicad_photonics/*.kicad_prl
examples/kicad_photonics/*.kicad_pcb
examples/kicad_photonics/*.bak
examples/kicad_photonics/*-backups/
examples/kicad_photonics/.history/
examples/kicad_photonics/~*

# chip experiments (experiments/<chip>/) — raw lightlab captures, extraction
# caches, KiCad working projects and machine-generated netlists never get
# committed. Fit outputs (results/*.json) and the model card do.
/experiments/*/data/
/experiments/*/kicad/
/experiments/*/netlists/
/experiments/*/results/*.png


# kicad_to_fairchild.py transpiled wrappers + sim outputs
*_transpiled_netlist.sp
*_transpiled_output
run_*.sp

# python bytecode
__pycache__/
*.pyc

# claude
.claude/

# Generated from a KiCad source checkout by python/fairchild/kicad/regen_protos.sh
python/fairchild/kicad/_proto/


# Old logo workspace
docs/logos/mockups
